{
  "name": "catlex",
  "version": "0.5.1",
  "description": "CLI to validate next-intl translation JSON files against a base locale",
  "type": "module",
  "private": true,
  "bin": {
    "catlex": "./src/bin/catlex.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/bin/catlex.ts",
    "validate": "bun run src/bin/catlex.ts validate",
    "test": "bun test --isolate",
    "build": "bun build ./src/bin/catlex.ts --compile --outfile dist/catlex",
    "install:local": "bun run build && mkdir -p \"$HOME/.local/bin\" && install -m 755 dist/catlex \"$HOME/.local/bin/catlex\" && echo \"Installed $HOME/.local/bin/catlex\"",
    "build:linux:x64": "bun build ./src/bin/catlex.ts --compile --target=bun-linux-x64 --outfile dist/catlex-linux-x64",
    "build:linux:arm64": "bun build ./src/bin/catlex.ts --compile --target=bun-linux-arm64 --outfile dist/catlex-linux-arm64",
    "build:mac:x64": "bun build ./src/bin/catlex.ts --compile --target=bun-darwin-x64 --outfile dist/catlex-darwin-x64",
    "build:mac:arm64": "bun build ./src/bin/catlex.ts --compile --target=bun-darwin-arm64 --outfile dist/catlex-darwin-arm64",
    "build:windows:x64": "bun build ./src/bin/catlex.ts --compile --target=bun-windows-x64 --outfile dist/catlex-windows-x64",
    "build:all": "bun run build:linux:x64 && bun run build:linux:arm64 && bun run build:mac:x64 && bun run build:mac:arm64 && bun run build:windows:x64",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --format json --quiet --explain --gate-marker agent",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.105",
    "ai": "^7.0.157",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7",
    "@typescript/typescript6": "6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^8.0.0",
    "typescript": "^7.0.2",
    "fallow": "3.37.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
